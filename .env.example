# Copy to .env to change a setting: cp .env.example .env
# `npm run setup` does the same and fills in the two secrets with random values.
# docker compose also works without a .env and generates the secrets itself.

# Runtime
NODE_ENV=development
# Time zone used to decide which invoices are overdue
APP_TIMEZONE=UTC
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Ports
BACKEND_PORT=4000
FRONTEND_PORT=8080
# Host port of the Docker database (5433 so it doesn't clash with a local Postgres)
POSTGRES_HOST_PORT=5433

# Database
# Compose sets the host and port itself. To run the API locally against the
# Docker database, set POSTGRES_PORT=5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=simpleinvoice
# Secret. Postgres only uses it when the database volume is first created.
POSTGRES_PASSWORD=
POSTGRES_DB=simpleinvoice

# Auth
# Secret, at least 32 characters. To make one:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Token lifetime in seconds
JWT_EXPIRES_IN=3600
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# Browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Number of proxies in front of the API (Compose uses 1 for nginx)
TRUST_PROXY=0
# Login attempts per minute, per IP and per account
LOGIN_RATE_LIMIT=10

# Seed
# Login created by the seed (see the README)
SEED_USER_EMAIL=admin@simpleinvoice.test
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Jordan Lee
# Docker only: seed when the API container starts
SEED_ON_START=true

# Frontend (read at build time and public)
VITE_API_BASE_URL=/api
# Where the Vite dev server sends /api requests
VITE_API_PROXY_TARGET=http://localhost:4000
